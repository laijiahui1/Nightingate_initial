# Nightingale environment template.
#
# Copy this file to `.env` and override the dev defaults before any non-local
# deployment. `.env` is gitignored — never commit real secrets.
#
#     cp .env.example .env
#     docker compose up
#
# The values below are SAFE DEV DEFAULTS only (no real credentials). Every
# secret placeholder must be replaced with a strong, random value in `.env`.

# ---- PostgreSQL -------------------------------------------------------
POSTGRES_USER=nightingale
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=nightingale
# Host port the database is exposed on (optional override).
POSTGRES_PORT=5432

# ---- Application database connection (used by the API) ----------------
# The API connects as the RESTRICTED `app_nightingale` login role (created by
# roles.sql), never the bootstrap superuser. Per-request `SET ROLE` happens in
# app/db/session.py (Pattern A). Override the password in a real `.env`.
APP_DB_USER=app_nightingale
APP_DB_PASSWORD=dev_app_password_change_me
# Dialect is psycopg (v3). Compose interpolates this from APP_DB_* above.
DATABASE_URL=postgresql+psycopg://app_nightingale:dev_app_password_change_me@db:5432/nightingale

# ---- Migration / seed connection (bootstrap superuser) ---------------
# apply_migrations.py / app.seed.py connect as the bootstrap POSTGRES_USER so
# they can CREATE ROLE and write the tables that only SECURITY DEFINER
# functions may touch at runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://nightingale:dev_password_change_me@db:5432/nightingale

# ---- Auth / JWT -------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev_secret_change_me
JWT_ALGORITHM=HS256
# Dev default is long for demo convenience; docs/SECURITY.md T8 recommends a
# 15-minute access token for production.
JWT_EXPIRE_MINUTES=480

# ---- Application ------------------------------------------------------
APP_ENV=development
APP_PORT=8000
# JSON array of allowed browser origins (the SPA dev server + the API).
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]

# ---- LLM gateway ------------------------------------------------------
# LLM_MOCK=1 (default) routes every model call to the deterministic mock-llm
# service. Set LLM_MOCK=0 and provide LLM_API_KEY / LLM_MODEL for a real
# provider behind the LLMGateway.
LLM_MOCK=1
LLM_BASE_URL=http://mock-llm:5000
# LLM_API_KEY=
# LLM_MODEL=mock-llm

# ---- Web (Vite dev server) --------------------------------------------
WEB_PORT=5173
